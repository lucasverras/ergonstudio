{
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "ergonagencia.com.br"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://www.ergonstudio.com.br/$1"
      }
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.ergonagencia.com.br"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://www.ergonstudio.com.br/$1"
      }
    },
    {
      "src": "/portfolio/[mM][oO][sS][aA][iI][cC][lL][aA][bB]/?$",
      "status": 410,
      "dest": "/410.html",
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow, noarchive"
      }
    },
    {
      "src": "/portfolio/[sS][oO][cC][cC][eE][rR]-[sS][tT][aA][tT][iI][oO][nN]/?$",
      "status": 410,
      "dest": "/410.html",
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow, noarchive"
      }
    },
    {
      "src": "/(imagens-aereas|filmagem-com-drone|drone-profissional|drone-para-imobiliarias|drone-para-restaurantes|drone-para-hoteis|drone-para-eventos|drone-sao-paulo|captacao-aerea|video-aereo-drone|guia-filmagem-com-drone)/?$",
      "status": 410,
      "dest": "/410.html",
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow, noarchive"
      }
    },
    {
      "src": "^/(.+)/$",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "^/portfolio(/.*)?$",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "^/assets/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/(og|fonts|images|logos|portfolio|videos|fly)/(.*)\\.(png|jpg|jpeg|webp|avif|svg|mp4|webm|woff2?|ttf)$",
      "headers": {
        "Cache-Control": "public, max-age=2592000"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html",
      "headers": {
        "X-Robots-Tag": "noindex"
      }
    }
  ]
}
